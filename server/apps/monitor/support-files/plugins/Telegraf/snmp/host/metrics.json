{
  "plugin": "Host SNMP General",
  "plugin_desc": "The SNMP general plugin is used to monitor and manage the status of host devices through SNMP. Administrators can obtain key information about the host, such as CPU usage, memory usage, disk usage, and network interface traffic, thereby optimizing host performance and improving management efficiency.",
  "support_collect_detect": true,
  "status_query": "any({instance_type='host', collect_type='snmp'}) by (instance_id)",
  "instance_fact_bindings": [{"fact":"asset.ip","value_type":"ip","resolver":"input","options":{"field":"ip"}}],
  "instance_summary_columns": [{"fact":"asset.ip","title":"monitor.views.assetIp","order":10}],
  "name": "Host",
  "icon": "mm-host_主机",
  "type": "Host",
  "description": "",
  "default_metric": "any({instance_type='host'}) by (instance_id)",
  "instance_id_keys": ["instance_id"],
  "supplementary_indicators": ["snmp_uptime", "host_cpu_usage", "host_memory_usage", "host_disk_usage"],
  "metrics": [
    {
      "metric_group": "Base",
      "name": "snmp_uptime",
      "query": "sum(snmp_uptime{instance_type='host', __$labels__}/100) by (instance_id)",
      "display_name": "System Uptime",
      "data_type": "Number",
      "unit": "s",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the uptime of the host since the last restart. By monitoring the uptime, administrators can understand the stability and reliability of the host and identify potential reboot or failure issues."
    },
    {
      "metric_group": "CPU",
      "name": "host_cpu_usage",
      "query": "host_cpu_usage{instance_type='host', __$labels__}",
      "display_name": "CPU Usage",
      "data_type": "Number",
      "unit": "%",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the CPU usage percentage of the host."
    },
    {
      "metric_group": "Memory",
      "name": "host_memory_usage",
      "query": "host_memory_usage{instance_type='host', __$labels__}",
      "display_name": "Memory Usage",
      "data_type": "Number",
      "unit": "%",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the memory usage percentage of the host."
    },
    {
      "metric_group": "Memory",
      "name": "host_memory_total",
      "query": "host_memory_total{instance_type='host', __$labels__}",
      "display_name": "Total Memory",
      "data_type": "Number",
      "unit": "byte",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the total memory size of the host."
    },
    {
      "metric_group": "Memory",
      "name": "host_memory_used",
      "query": "host_memory_used{instance_type='host', __$labels__}",
      "display_name": "Used Memory",
      "data_type": "Number",
      "unit": "byte",
      "dimensions": [],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the used memory size of the host."
    },
    {
      "metric_group": "Disk",
      "name": "host_disk_usage",
      "query": "host_disk_usage{instance_type='host', __$labels__}",
      "display_name": "Disk Usage",
      "data_type": "Number",
      "unit": "%",
      "dimensions": [{"name": "path", "description": "Disk Path"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the disk usage percentage of the host."
    },
    {
      "metric_group": "Disk",
      "name": "host_disk_total",
      "query": "host_disk_total{instance_type='host', __$labels__}",
      "display_name": "Total Disk",
      "data_type": "Number",
      "unit": "byte",
      "dimensions": [{"name": "path", "description": "Disk Path"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the total disk size of the host."
    },
    {
      "metric_group": "Disk",
      "name": "host_disk_used",
      "query": "host_disk_used{instance_type='host', __$labels__}",
      "display_name": "Used Disk",
      "data_type": "Number",
      "unit": "byte",
      "dimensions": [{"name": "path", "description": "Disk Path"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the used disk size of the host."
    },
    {
      "metric_group": "Network",
      "name": "interface_ifAdminStatus",
      "query": "interface_ifAdminStatus{instance_type='host', __$labels__}",
      "display_name": "Interface Admin Status",
      "data_type": "Enum",
      "unit": "[{\"name\":\"up\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"down\",\"id\":2,\"color\":\"#ff4d4f\"},{\"name\":\"testing\",\"id\":3,\"color\":\"#faad14\"}]",
      "dimensions": [{"name": "ifDescr", "description": "ifDescr"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the administrative status of the network interface."
    },
    {
      "metric_group": "Network",
      "name": "interface_ifOperStatus",
      "query": "interface_ifOperStatus{instance_type='host', __$labels__}",
      "display_name": "Interface Oper Status",
      "data_type": "Enum",
      "unit": "[{\"name\":\"up\",\"id\":1,\"color\":\"#1ac44a\"},{\"name\":\"down\",\"id\":2,\"color\":\"#ff4d4f\"},{\"name\":\"testing\",\"id\":3,\"color\":\"#faad14\"}]",
      "dimensions": [{"name": "ifDescr", "description": "ifDescr"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric reflects the actual operational status of the network interface."
    },
    {
      "metric_group": "Network",
      "name": "interface_ifInOctets",
      "query": "rate(interface_ifInOctets{instance_type='host', __$labels__}[5m])",
      "display_name": "Interface Incoming Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [{"name": "ifDescr", "description": "ifDescr"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the average rate of bytes received over the past 5 minutes."
    },
    {
      "metric_group": "Network",
      "name": "interface_ifOutOctets",
      "query": "rate(interface_ifOutOctets{instance_type='host', __$labels__}[5m])",
      "display_name": "Interface Outgoing Traffic Rate",
      "data_type": "Number",
      "unit": "byteps",
      "dimensions": [{"name": "ifDescr", "description": "ifDescr"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric calculates the average rate of bytes sent over the past 5 minutes."
    },
    {
      "metric_group": "Network",
      "name": "interface_ifSpeed",
      "query": "interface_ifSpeed{instance_type='host', __$labels__}",
      "display_name": "Interface Bandwidth",
      "data_type": "Number",
      "unit": "bitps",
      "dimensions": [{"name": "ifDescr", "description": "ifDescr"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric indicates the maximum data transmission speed supported by the network interface."
    },
    {
      "metric_group": "Network",
      "name": "interface_ifInErrors",
      "query": "rate(interface_ifInErrors{instance_type='host', __$labels__}[5m])",
      "display_name": "Incoming Errors Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "ifDescr", "description": "ifDescr"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric calculates the average rate of incoming error packets over the past 5 minutes."
    },
    {
      "metric_group": "Network",
      "name": "interface_ifOutErrors",
      "query": "rate(interface_ifOutErrors{instance_type='host', __$labels__}[5m])",
      "display_name": "Outgoing Errors Rate",
      "data_type": "Number",
      "unit": "cps",
      "dimensions": [{"name": "ifDescr", "description": "ifDescr"}],
      "instance_id_keys": ["instance_id"],
      "description": "This metric calculates the average rate of outgoing error packets over the past 5 minutes."
    }
  ]
}